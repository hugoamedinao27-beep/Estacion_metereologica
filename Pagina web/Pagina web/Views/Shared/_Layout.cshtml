<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="MeteoGuard: estación meteorológica IoT con dashboard de temperatura y humedad en tiempo real, alertas configurables e historial." />
  <meta name="theme-color" content="#2563eb" />
  <title>@(ViewData["Title"] is not null ? $"{ViewData["Title"]} · MeteoGuard" : "MeteoGuard · Estación Meteorológica IoT")</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='48' fill='%232563eb'/%3E%3Ctext x='50' y='68' font-size='58' text-anchor='middle' fill='white' font-family='sans-serif'%3EM%3C/text%3E%3C/svg%3E" />
  <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" defer></script>
</head>
<body>

  <a class="skip-link" href="#contenido">Saltar al contenido principal</a>

  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" asp-controller="Home" asp-action="Index" aria-label="MeteoGuard, ir al inicio">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/>
          </svg>
        </span>
        <span class="brand-text">MeteoGuard</span>
      </a>

      <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="primaryNav" aria-label="Abrir menú de navegación">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>

      <nav class="primary-nav" id="primaryNav" aria-label="Navegación principal">
        <ul>
          <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
          <li><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
          <li><a asp-controller="History" asp-action="Index">Historial</a></li>
          <li><a asp-controller="Settings" asp-action="Index">Configuración</a></li>
          <li><a asp-controller="Home" asp-action="Index" asp-fragment="arquitectura">Arquitectura</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="contenido">
    @RenderBody()
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <span class="brand-text">MeteoGuard</span>
        <p>Estación meteorológica IoT · Monitoreo de temperatura y humedad con datos simulados, alertas e historial.</p>
      </div>
      <div class="footer-meta">
        <p class="footer-label">Proyecto académico</p>
        <p>Asignatura: Internet de las Cosas / Programación en la Nube</p>
        <p>Daniel Madrid · Diego Oyarzo · Nicolás Díaz · Hugo Medina</p>
        <p>Docente: Osvaldo Archile</p>
      </div>
    </div>
    <div class="container footer-bottom">
      <p>© 2026 MeteoGuard · Temática N.º 7 — Monitoreo meteorológico IoT. Desplegado en Microsoft Azure.</p>
    </div>
  </footer>

  <script src="~/js/site.js" defer></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
