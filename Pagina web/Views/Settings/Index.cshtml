@model EstacionMeteorologica.Models.ThresholdConfig
@{
    ViewData["Title"] = "Configuración";
    var status = TempData["Status"] as string;
    var message = TempData["Message"] as string;
}

<section class="section" id="configuracion">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">Parámetros del sistema</p>
      <h2>Configurar umbrales de alerta</h2>
      <p class="section-intro">
        Los umbrales definen cuándo cambia el estado de alerta. Se validan en el
        servidor (DataAnnotations + reglas cruzadas) y se persisten en Firebase.
      </p>
    </header>

    @if (message is not null)
    {
      <div class="alert alert-@status" role="status">
        @message
      </div>
    }

    @if (!(ViewBag.FirebaseConfigured as bool? ?? false))
    {
      <div class="alert alert-warning" role="alert">
        <strong>Firebase no está configurado.</strong>
        El formulario funciona y valida, pero no podrá guardar hasta completar
        <code>Firebase:DatabaseUrl</code>.
      </div>
    }

    <div class="settings-grid">
      <form asp-controller="Settings" asp-action="Index" method="post" class="card settings-form" novalidate>
        <h3>Umbrales (en °C)</h3>

        <div class="form-field">
          <label asp-for="ColdThreshold"></label>
          <input asp-for="ColdThreshold" type="number" min="0" max="40" step="1" />
          <span class="field-error" asp-validation-for="ColdThreshold"></span>
        </div>

        <div class="form-field">
          <label asp-for="CautionThreshold"></label>
          <input asp-for="CautionThreshold" type="number" min="1" max="50" step="1" />
          <span class="field-error" asp-validation-for="CautionThreshold"></span>
        </div>

        <div class="form-field">
          <label asp-for="CalorThreshold"></label>
          <input asp-for="CalorThreshold" type="number" min="2" max="60" step="1" />
          <span class="field-error" asp-validation-for="CalorThreshold"></span>
        </div>

        <div class="form-field">
          <label asp-for="CriticalThreshold"></label>
          <input asp-for="CriticalThreshold" type="number" min="3" max="65" step="1" />
          <span class="field-error" asp-validation-for="CriticalThreshold"></span>
        </div>

        <button type="submit" class="btn btn-primary">Guardar umbrales</button>
      </form>

      <article class="card">
        <h3>Cómo se aplican</h3>
        <ul class="tick-list">
          <li><strong>Frío:</strong> temperatura menor al umbral de frío.</li>
          <li><strong>Normal:</strong> entre el umbral de frío y el de precaución.</li>
          <li><strong>Precaución:</strong> desde el umbral de precaución.</li>
          <li><strong>Calor:</strong> desde el umbral de calor.</li>
          <li><strong>Crítico:</strong> desde el umbral crítico.</li>
        </ul>
        <p style="margin-top:1rem;">
          La regla de negocio exige umbrales crecientes:
          <em>frío &lt; precaución &lt; calor &lt; crítico</em>. Si no se cumple,
          el servidor rechaza el guardado y muestra el error en el campo correspondiente.
        </p>
      </article>
    </div>
  </div>
</section>
